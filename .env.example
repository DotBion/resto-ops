# Copy to .env and fill in. Never commit .env.
GEMINI_API_KEY=

# ---- Server ----
# Host header allow-list (comma separated). *.trycloudflare.com lets a cloudflared quick tunnel through.
ALLOWED_HOSTS=localhost,127.0.0.1,testserver,*.trycloudflare.com
# Where the shared SQLite journal (operations.sqlite3) and media live. Default: ./.cafe-ops
# CAFE_HOME=

# ---- Queue Monitor (from cafe-ops-agent) ----
CAFE_OBSERVER_MODEL=gemini-4-hydrogen
CAFE_VERIFIER_MODEL=gemini-4-argon
# LOW is the lowest level Gemini 4 accepts (MINIMAL is rejected). OFF omits the setting and the
# model falls back to its default (much slower: ~17 s vs ~4 s per call in our test).
CAFE_THINKING_LEVEL=LOW
CAFE_MAX_CALLS_PER_RUN=30
CAFE_MAX_CALLS_PER_PROCESS=100
CAFE_GEMINI_TIMEOUT_SECONDS=20
CAFE_WINDOW_MS=5000
CAFE_CADENCE_MS=6000
CAFE_MAX_OBSERVATION_LAG_MS=30000
CAFE_QUEUE_THRESHOLD=4
CAFE_PERSISTENCE_MS=2000

# ---- Fix-It Cam (from fixitcam) ----
IDENTIFY_MODEL=gemini-4-hydrogen
RANK_MODEL=gemini-4-argon
DECISION_MODEL=gemini-decision-1
# "", "low" or "high" ("minimal" is rejected by Gemini 4)
DIAGNOSE_THINKING=
RANK_THINKING=low
MAX_CANDIDATES=18
MAX_UPLOAD_MB=200
SHOP_MCP_URL=https://mcp.shop.com/
# Optional key protecting /fixit/eval-upload (?k=...)
EVAL_UPLOAD_KEY=

# Past cases + overnight analysis (Stress Lab in VoicePizza). Nightly at CAFE_ANALYSIS_HOUR America/New_York.
CAFE_ANALYSIS_ENABLED=1
CAFE_ANALYSIS_HOUR=2
CAFE_ANALYSIS_MODEL=gemini-4-argon
CAFE_ANALYSIS_THINKING_LEVEL=HIGH
CAFE_ANALYSIS_BATCH=40
CAFE_ANALYSIS_MAX_CALLS=6
CAFE_ANALYSIS_TIMEOUT_SECONDS=180
